{
  "name": "@probe/worker",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "node dist/index.js",
    "dev": "tsx --env-file-if-exists=../../.env watch src/index.ts",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/cli.ts seed",
    "dry-run": "tsx --env-file-if-exists=../../.env src/cli.ts dry-run"
  },
  "dependencies": {
    "@probe/config": "workspace:*",
    "@probe/core": "workspace:*",
    "@probe/db": "workspace:*",
    "cheerio": "^1.0.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11"
  }
}
