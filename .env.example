# ---------------------------------------------------------------------------
# probe environment. Copy to .env and fill in. Never commit .env.
#
# The four lines that decide whether a real email can leave are marked LIVE.
# `pnpm --filter @probe/worker cli preflight` checks all of them and tells you
# what is missing, so run that rather than reading this file twice.
# ---------------------------------------------------------------------------

# Postgres (Supabase). Use the pooler connection string for apps/web on Vercel
# and the direct connection for apps/worker on the VPS.
SUPABASE_DB_URL=postgres://postgres:password@localhost:5432/probe

# Supabase project handles. Not used for data access (probe talks raw SQL,
# service-role, server-side only) but kept for tooling.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Peppered contact hashing (§9.3). NEVER ROTATE: rotating orphans every
# suppression row, which makes every person who opted out contactable again.
# 32+ random bytes, hex or base64.
PROBE_HASH_PEPPER=

# Generator request signing (§6). HMAC-SHA256(secret, timestamp + "." + body).
# The SAME value must be set on the exit1 side as the PROBE_HMAC_SECRET Firebase
# secret, or every generator call comes back 401.
#   firebase functions:secrets:set PROBE_HMAC_SECRET
PROBE_HMAC_SECRET=

# LIVE. §3.1 rule 4 and §5.5. Dry-run is the default. Must be exactly "true"
# to send: "TRUE", "1" and "yes" all mean dry-run. When this is true the worker
# runs the preflight on boot and refuses to start if anything below is wrong.
PROBE_SEND_ENABLED=false

# LIVE. Public base URL of apps/web. Every unsubscribe link, every
# List-Unsubscribe header, every click redirect and the data notice are built
# from this, and it OVERRIDES probe.toml's public_base_url when set.
#
# The localhost value below is right for `pnpm web:dev` and catastrophic in
# production: it would put an unreachable unsubscribe link in every email. The
# preflight refuses to let the worker start live with a localhost or non-https
# value, which is the only reason it is safe to ship a default here at all.
PROBE_PUBLIC_URL=http://localhost:3000

# Who approvals are recorded as.
PROBE_APPROVER=morten

# Where the dry-run harness writes .eml files (§13 M0).
PROBE_OUTBOX_DIR=./outbox

# ---------------------------------------------------------------------------
# Day3 (§5.1). probe does not talk to SES: Day3 does.
#
# There is no separate AWS account, no SES production access request and no
# per-product DKIM/MAIL FROM/DMARC to publish. Day3 already owns the SES
# account, the verified sending domains and the reputation that exit1's own mail
# runs on, and probe is one more caller of its transactional API. What probe has
# to do is verify its sending domain in the Day3 dashboard under Domains, the
# same way any other Day3 account does.
# ---------------------------------------------------------------------------

# LIVE. A Day3 live API key, from the Day3 dashboard under API keys.
# `day3_live_` plus 40 characters. A `day3_test_` key is rejected by Day3.
DAY3_API_KEY=

# The Day3 API base url. The API is on go.day3.app, not the apex: day3.app
# serves the marketing site and returns 404 for /api/v1/emails, which fails
# every send with no way to tell it from a bad key. Only change this to point
# at a staging deployment.
DAY3_API_BASE_URL=https://go.day3.app

# LIVE. The signing secret for the Day3 webhook endpoint, `whsec_...`. Created
# with the endpoint in the Day3 dashboard, which shows it exactly once.
#
# Point the endpoint at https://<web-host>/hooks/day3 and subscribe it to:
#   email.delivered  email.bounced  email.complained  email.failed
#
# Without this, /hooks/day3 rejects every delivery, so bounces and complaints
# never reach the suppression list and the §5.5 auto-pause is blind. That is a
# compliance problem, not a metrics problem, which is why the preflight treats a
# missing value as a blocker rather than a warning.
DAY3_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Replies (§5.3). This is the one thing Day3 does not do: it has no inbound
# side. So replies still arrive over SES receive, in the Day3 AWS account:
# an inbound receipt rule on the reply address writes to S3 and publishes to
# SNS, which posts to /hooks/ses. A reply inserts a suppression before anything
# else happens.
# ---------------------------------------------------------------------------

# The SNS topic ARN carrying inbound mail. REQUIRED, and the endpoint returns
# 403 to everything when it is empty.
#
# A valid SNS signature only proves a message came from SNS, not that it came
# from YOUR topic: anyone with an AWS account can create a topic, subscribe this
# endpoint and post forged bounces, each of which writes a permanent suppression
# with no resubscribe path. The ARN allowlist is what makes the signature mean
# something. Comma separated.
SNS_ALLOWED_TOPIC_ARNS=

# Where /hooks/ses forwards genuine replies and automated mail (§5.3).
REPLY_FORWARD_TO=

# ---------------------------------------------------------------------------
# Sources (§8.1)
# ---------------------------------------------------------------------------

# Without a token the Product Hunt source ships disabled rather than broken,
# which is a configuration state and not a sweep failure. Show HN needs nothing.
PRODUCT_HUNT_TOKEN=

# §8.3 step 6, the paid lookup. Absent without a key: there is no silent
# fallback to a paid provider, and §13 M2 says not to reach this step until the
# free steps have been measured.
FINDYMAIL_KEY=

# ---------------------------------------------------------------------------
# apps/web only. Cloudflare Access in front of the dashboard (§9.3).
#
# The app VERIFIES Cloudflare's signed assertion; it does not trust the identity
# header. A request that reaches the Vercel origin directly (the *.vercel.app
# hostname, or a preview deployment's own hostname) never passed through
# Cloudflare and can set that header to anything, so the header alone was never
# authentication. Turn on Vercel Deployment Protection as well, so the origin is
# not reachable without Cloudflare in front of it.
# ---------------------------------------------------------------------------

# Set to "false" ONLY for local development. Anything else, including unset,
# means the gate is on: the default now fails closed, because one missing
# variable in Vercel used to remove the gate entirely with nothing saying so.
CF_ACCESS_REQUIRED=true

# The Cloudflare Access team domain. A bare team name works; only
# *.cloudflareaccess.com hosts are accepted, because otherwise this variable
# would be a way to point key verification at a server someone else controls.
CF_ACCESS_TEAM_DOMAIN=

# The Access application's AUD tag, from the application's Overview tab.
# Required, and checked on every request: every application in a Cloudflare team
# is signed by the SAME keys, so a valid signature is not enough on its own. A
# token minted for any other application in the account would otherwise verify.
CF_ACCESS_AUD=

# Identities allowed onto the operator screens. Empty means nobody.
CF_ACCESS_ALLOWED_EMAILS=mpg@optipeople.dk
